# Use only the origin of your school's Canvas installation. HTTPS is required.
CANVAS_API_URL=https://school.instructure.com
CANVAS_API=

# Create an internal Notion integration and share the parent page with it.
NOTION_API=
NOTION_PAGE=

# Optional. Leave blank on the first run; the CLI stores created IDs in a
# local, ignored state file. These values can be supplied to reuse a database.
NOTION_DATABASE=
NOTION_DATA_SOURCE=
